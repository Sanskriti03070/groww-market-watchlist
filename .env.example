# Neon Postgres connection string (Pool/WebSocket driver).
# Get this from the Neon console: https://console.neon.tech/
DATABASE_URL=postgres://user:password@ep-example-000000.region.aws.neon.tech/dbname?sslmode=require

# Signs observation acknowledgement tokens (lib/observation-token.ts). Any
# long random string; generate with `openssl rand -base64 32`.
OBSERVATION_TOKEN_SECRET=

# Shared secret an external scheduler (cron-job.org / GitHub Actions) sends
# as `Authorization: Bearer <value>` to invoke POST|GET /api/market/refresh.
# Server-side only - never exposed to the browser. Generate with
# `openssl rand -base64 32`. Without it, the refresh endpoint returns 401.
MARKET_REFRESH_SECRET=
